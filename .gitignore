# Rust / Cargo
/target
**/*.rs.bk

# Secrets & local config
.env
.env.*
!.env.example

# Logs
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test data / corpus
corpus/
testdata/

# Docker Compose local data
data/

build/

# Working bundle artifact (named release lives in releases/)
/spindle-bundle.tar.gz

# Binary artifacts / Python bytecode
releases/*.tar.gz
**/*.pyc
__pycache__/
tools/evidence-collector/output/

# Build artifacts in build directory
build/spindle-bundle/bin/
build/spindle-bundle/etc/

# Generated SBOM (use `make sbom` to regenerate)
bom.json

# Release artifacts — dev build output is not committed;
# versioned dist dirs (dist/ubuntu/22.04/, dist/ubuntu/24.04/) and stub
# READMEs (dist/rhel/README.md, etc.) ARE committed as structural templates.
# Actual binaries are generated by `make release` and uploaded as CI release
# assets — they are NOT committed to git.
dist/ubuntu/*/spindle-server
dist/ubuntu/*/spindle-worker
dist/ubuntu/*/spindle
dist/ubuntu/*/spindle-migrate
dist/ubuntu/*/SHA256SUMS
dist/ubuntu/dev/

