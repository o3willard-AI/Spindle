# Spindle Environment Configuration
# Copy to .env and fill in values: cp .env.example .env
# All variables can also be set in a TOML config file or as CLI args.
# Env vars override config file values.

# ── Core ─────────────────────────────────────────────────────────────────────

# PostgreSQL database connection string. REQUIRED in production.
# Format: postgres://USER:PASS@HOST:PORT/DBNAME
SPINDLE_DATABASE_URL=postgres://spindle:CHANGE_ME@localhost:5432/spindle

# Set to "1" for production mode. In production, the server will EXIT(1)
# if it cannot connect to the database — no silent in-memory fallback.
# Set to "0" (or unset) for dev mode with in-memory fallback.
SPINDLE_PRODUCTION=0

# ── Auth & Identity ──────────────────────────────────────────────────────────

# Bearer token for ingest API authentication. Defaults to "spindle-dev-token".
# REQUIRED in production — generate a strong secret:
#   openssl rand -hex 32
SPINDLE_INGEST_TOKEN=changeme-in-production

# JWT signing secret for auth tokens. REQUIRED in production (SPINDLE_PRODUCTION=1).
# In dev mode, a safe default is used. Generate a strong secret:
#   openssl rand -hex 32
SPINDLE_JWT_SECRET=changeme-jwt-secret

# ── TLS ──────────────────────────────────────────────────────────────────────

# Path to TLS certificate file (PEM format).
# The server does not terminate TLS directly — set these and run behind a
# reverse proxy, OR set SPINDLE_TLS_ENABLED=1 to enable built-in TLS.
# Required in production if terminating TLS at the app layer.
SPINDLE_TLS_CERT=/etc/spindle/tls.crt
SPINDLE_TLS_KEY=/etc/spindle/tls.key

# ── Storage Backend ──────────────────────────────────────────────────────────

# Storage backend for raw archive data.
# Options: "local" (filesystem) or "s3" (S3-compatible object storage)
# Default: local
SPINDLE_STORAGE_BACKEND=local

# S3 endpoint URL (required if SPINDLE_STORAGE_BACKEND=s3)
# Example: https://s3.us-east-1.amazonaws.com or http://minio:9000
SPINDLE_S3_ENDPOINT=http://minio:9000

# S3 bucket name for archive storage (required if S3 backend)
SPINDLE_S3_BUCKET=spindle-archive

# S3 region (default: us-east-1)
SPINDLE_S3_REGION=us-east-1

# S3 access key (required if S3 backend)
SPINDLE_S3_ACCESS_KEY_ID=
SPINDLE_S3_SECRET_ACCESS_KEY=

# S3 path-style URLs (required for MinIO and some S3-compatible stores)
SPINDLE_S3_PATH_STYLE=true

# Archive root directory (for local backend only)
# Default: /var/lib/spindle/archive
SPINDLE_ARCHIVE_DIR=/var/lib/spindle/archive

# ── Identity Provider (Dex/OIDC) ─────────────────────────────────────────────

# Dex issuer URL (required if SPINDLE_DEX_ENABLED=true)
# Example: https://dex.spindle.example.com
# NOTE: SPINDLE_DEX_ENABLED is not yet wired into code — set via config file.
SPINDLE_DEX_ENABLED=false
SPINDLE_DEX_ISSUER_URL=https://dex.spindle.example.com

# OAuth2 client ID registered with Dex
SPINDLE_DEX_CLIENT_ID=

# OAuth2 client secret registered with Dex
SPINDLE_DEX_CLIENT_SECRET=

# OIDC redirect URI (must match Dex client registration)
SPINDLE_DEX_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Signing ───────────────────────────────────────────────────────────────────

# Signing key mode: "local" (Ed25519 on disk), "pgp" (GPG/PGP keyring), "disabled"
# Default: disabled
SPINDLE_SIGNING_MODE=local

# Path to Ed25519 signing key (for local mode)
# Default: /etc/spindle/signing-key.pem
SPINDLE_SIGNING_KEYRING_PATH=/etc/spindle/signing-key.pem

# Signing key ID (hex) for key rotation tracking
SPINDLE_SIGNING_KEY_ID=

# ── Ingest ────────────────────────────────────────────────────────────────────

# Maximum payload size in bytes (default: 10485760 = 10MB)
SPINDLE_INGEST_MAX_PAYLOAD_SIZE=10485760

# Rate limit: max runs/sec ingested (default: 500)
SPINDLE_INGEST_RATE_LIMIT=500

# Rate limit burst allowance (default: 1000)
SPINDLE_INGEST_RATE_LIMIT_BURST=1000

# Enable the auditor (InSpec) direct-ingest endpoint (default: true)
SPINDLE_INGEST_AUDITOR_ENABLED=true

# ── Server ────────────────────────────────────────────────────────────────────

# Host to bind (default: 127.0.0.1)
SPINDLE_SERVER_HOST=127.0.0.1

# Port to bind (default: 3000)
SPINDLE_SERVER_PORT=3000

# Enable CORS (default: false)
SPINDLE_SERVER_CORS_ENABLED=false

# ── Observability ─────────────────────────────────────────────────────────────

# Log level: operational, diagnostic, debug (default: operational)
SPINDLE_LOG_LEVEL=operational

# Log output target: json (structured, default) or stdout (human-readable)
SPINDLE_LOG_TARGET=json

# Prometheus metrics endpoint path (default: /metrics)
SPINDLE_PROMETHEUS_PATH=/metrics

# ── Local Accounts ─────────────────────────────────────────────────────────────

# Enable local user accounts (database-backed, separate from OIDC)
# Options: "true" or "1" to enable, "false" or unset to disable (default)
SPINDLE_LOCAL_ACCOUNTS_ENABLED=false

# Max password age in days (0 = no expiry, default: 90)
SPINDLE_PASSWORD_MAX_AGE_DAYS=90

# Password expiration warning period in days (default: 7)
SPINDLE_PASSWORD_WARNING_DAYS=7

# Max failed login attempts before account lock (default: 5)
SPINDLE_MAX_FAILED_ATTEMPTS=5

# ── Auth Rate Limiting ────────────────────────────────────────────────────────
# Per-endpoint rate limits for auth endpoints (requests per minute)
# Format: "login:N,register:N"  (login default: 5, register default: 3)
# SPINDLE_AUTH_RATE_LIMIT=login:5,register:3

# ── Data Retention ─────────────────────────────────────────────────────────────

# Raw data retention in days (default: 90)
SPINDLE_RAW_RETENTION_DAYS=90

# Processed data retention in days (default: 365)
SPINDLE_PROCESSED_RETENTION_DAYS=365

# Archive retention in days (0 = forever, default: 0)
SPINDLE_ARCHIVE_RETENTION_DAYS=0

# ── Configuration File ─────────────────────────────────────────────────────────

# Path to a TOML config file. If not set, Spindle searches:
# 1. SPINDLE_CONFIG env var
# 2. ~/.config/spindle/config.toml
# 3. /etc/spindle/spindle.toml
SPINDLE_CONFIG=/etc/spindle/spindle.toml
